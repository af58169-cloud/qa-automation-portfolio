{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and TypeScript portfolio: SauceDemo UI and Automation Exercise API tests",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/capture-demo.cjs"
  },
  "devDependencies": {"@playwright/test": "1.63.0", "@types/node": "24.19.1", "typescript": "5.9.3"}
}
